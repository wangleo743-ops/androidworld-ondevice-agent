<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.lab.androidworldplanner">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.systemui" />
        <package android:name="com.android.camera2" />
    </queries>
    <application android:label="AndroidWorld benchmark model" android:allowBackup="false"
        android:debuggable="false" android:usesCleartextTraffic="true">
        <provider android:name=".PlannerProvider" android:authorities="com.lab.androidworldplanner.model"
            android:exported="true" android:permission="android.permission.DUMP" android:grantUriPermissions="false" />
    </application>
</manifest>
